# Copy this file to .env (do not commit .env) or set these in your environment.
# The app reads these values in homeViews.py.

SMTP_HOST=mail.fcjamison.com
SMTP_PORT=465
SMTP_USER=frank@fcjamison.com
SMTP_PASSWORD=

# Optional
SMTP_FROM=frank@fcjamison.com
SMTP_TO=frank@fcjamison.com
SMTP_USE_TLS=0
SMTP_USE_SSL=1

# If your server uses a private/self-signed CA, point this at a CA bundle file:
# SMTP_CA_FILE=C:\path\to\ca-bundle.pem

# Dev-only: disable cert verification (do not use in production)
SMTP_ALLOW_INVALID_CERT=0
