        },
        {
            "label": "Dev: Flask + Open Browser",
            "type": "shell",
            "command": "wsl",
            "options": {
                "cwd": "C:\\"
            },
            "args": [
                "bash",
                "-lc",
                "echo 'Starting Flask + opening browser...'"
            ],
            "dependsOn": [
                "Flask: Run (dev server)",
                "Open in Browser"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Dev: Flask(5001) + Open Browser",
