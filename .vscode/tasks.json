{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flask: Run (dev server)",
            "type": "shell",
            "command": "wsl",
            "options": {
                "cwd": "C:\\"
            },
            "args": [
                "bash",
                "-lc",
                "cd /home/frank/Websites/046-2026-FCJamison.com && FLASK_DEBUG=1 HOST=127.0.0.1 PORT=5000 ./.venv/bin/python ./app.py"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "flask",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": [
                    {
                        "regexp": "^$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*\\* Serving Flask app.*",
                    "endsPattern": ".*\\* Running on http://.*:5000.*"
                }
            }
        },
        {
            "label": "Open in Browser",
            "type": "shell",
            "command": "start",
            "args": [
                "chrome",
                "http://127.0.0.1:5000/"
            ],
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Flask: Run (dev server :5001)",
            "type": "shell",
            "command": "wsl",
            "options": {
                "cwd": "C:\\"
