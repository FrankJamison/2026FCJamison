# --- Python build/runtime ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
.venv-linux/
venv/
ENV/

# --- Windows Zone.Identifier metadata (can appear when copying from Windows) ---
*:Zone.Identifier

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Deploy (keep configs, ignore secret artifacts) ---
/deploy/**/.env
/deploy/**/.env.*
/deploy/**/secrets*
/deploy/**/private/
/deploy/**/ssl/
/deploy/**/certs/
/deploy/**/*.key
/deploy/**/*.pem
/deploy/**/*.p12
/deploy/**/*.pfx
/deploy/**/*.jks
/deploy/**/*.crt
/deploy/**/*.cer
/deploy/**/*.csr

# --- Flask / tooling caches ---
.instance/
.flaskenv
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# --- OS / editor noise ---
.DS_Store
Thumbs.db

# Keep VS Code tasks/settings if you want reproducible dev setup
!.vscode/

# --- App runtime data (do not commit user submissions) ---
# Contact + blog reply CSV storage created at runtime by homeViews.py
/data/

# If you ever add local uploads, ignore them too
/uploads/

# Untracked local image (not referenced; keep ignored)
/static/images/portfolio/Frank\ Headshot.jpg

# --- Generated reports (do not commit) ---
/unused-css-report.txt
/unused-assets-report.txt
